  "cards": [
    {
      "dot": "emerald",
      "title": "Employee (Співробітник)",
      "items": [
        "Id: uuid [PK, первинний ключ]",
        "Name: string [ПІБ, валідовано C# + btrim]",
        "Email: string [Унікальний індекс ix_employees_email]",
        "IsActive: boolean [BR3: прапорець активності]"
      ]
    },
    {
      "dot": "cyan",
      "title": "TaskItem (Завдання)",
      "items": [
        "Id: uuid [PK, GUID v7 послідовний]",
        "Title: string (до 200 симв.) & Description (опціональний)",
        "Status: TaskItemStatus (New, InProgress, Completed, Cancelled)",
        "PlannedStartAt & DueAt [BR2: DueAt >= PlannedStartAt]",
        "CompletedAt [BR1: тільки для status = Completed]",
        "CreatorId [FK, BR5] & AssigneeId [FK, BR3]",
        "Xmin: uint [OCC токен версії рядка]"
      ]
    },
    {
      "dot": "rose",
      "title": "Доменні інваріанти (BR1-BR5)",
      "items": [
        "BR1: CompletedAt обов'язковий і дозволений виключно для Completed",
        "BR2: DueAt не може бути раніше за PlannedStartAt",
        "BR3: Призначення дозволено тільки активним (IsActive = true)",
        "BR5: Постановник та виконавець не можуть збігатися (Creator != Assignee)"
      ]
    }
  ]
